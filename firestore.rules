rules_version = '2';

// GroupApp Firestore rules.
//
// Identity note: this app keys membership and role permissions on EMAIL, so
// these rules compare against request.auth.token.email throughout.
//
// The check-in rules at the bottom are the strict ones: they replace what a
// Cloud Function would otherwise enforce, so that QR check-in works on the
// free Spark plan. Everything above them is deliberately close to the
// app's existing behaviour — these rules are written to secure check-in
// without breaking features that already ship.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isMember(groupId) {
      return signedIn() && myEmail() in groupData(groupId).members;
    }

    function hasGroupPermission(groupId, permission) {
      let g = groupData(groupId);
      return signedIn() &&
        (g.createdBy == myEmail()
          || ('memberPermissions' in g
              && myEmail() in g.memberPermissions
              && permission in g.memberPermissions[myEmail()])
          // Existing clubs keep their former admin behavior until the owner
          // saves the new role assignments.
          || (!('memberPermissions' in g)
              && myEmail() in g.admins));
    }

    // Set by the verifyAdminSignupCode flow as a custom claim.
    // Two sources, because both exist in practice: the custom claim set by
    // verifyAdminSignupCode, and the users/{uid}.schoolAdmin field that the
    // app itself falls back to (ChatService.isCurrentUserSchoolAdmin). Only
    // checking the claim would lock out an admin promoted via the field.
    function isSchoolAdmin() {
      return signedIn() && (
        request.auth.token.schoolAdmin == true
        || get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('schoolAdmin', false) == true
      );
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      // Profiles are looked up by email across the app (member lists, DM
      // partners, profile pictures), so reads stay open to signed-in users.
      allow read: if signedIn();
      // A user may only write their own profile document.
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ------------------------------------------------- check-in token lookup
    // Maps an opaque QR token to the member it belongs to, so an admin's
    // scanner can resolve a scan without being able to read anyone's token.
    //
    // 'get' is allowed because resolving a scan requires reading the exact
    // document whose id is the scanned token. 'list' is denied so the
    // collection cannot be enumerated to harvest tokens.
    match /checkInTokens/{token} {
      allow get: if signedIn();
      allow list: if false;

      // A member may only ever point a token at themselves.
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail();
      // Rotating a token deletes the old mapping.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // --------------------------------------------------------------- groups
    match /groups/{groupId} {
      // Public groups are discoverable; private ones only by their members.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == myEmail()
        && myEmail() in request.resource.data.members
        && myEmail() in request.resource.data.admins;

      // Only the creator may change role definitions or assignments.
      // Other roles can update only the group settings their permission allows.
      allow update: if isSchoolAdmin()
        || (signedIn() && resource.data.createdBy == myEmail())
        || (hasGroupPermission(groupId, 'manage_settings')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'isPublic', 'requestedPublicOnCreate',
                 'publicRequestStatus', 'publicRequestSubmittedAt',
                 'publicReviewedAt', 'publicReviewedBy',
                 'publicRejectionReason', 'whoCanPost', 'themeColor',
                 'themeIcon', 'bannerUrl', 'overview', 'keywords',
                 'roomNumber'
               ]))
        || (hasGroupPermission(groupId, 'manage_messages')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'pinnedMessageId', 'pinnedMessageText',
                 'pinnedMessageSender', 'pinnedAt'
               ]))
        || (
        signedIn()
        // A joining user may only add themselves to members and change
        // nothing else about the group.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.removeAll(resource.data.members)
             == [myEmail()]
      )
        // Any member may set their own availability, and only their own.
        // Comparing the two maps is what stops someone marking the whole
        // club Away; the first branch covers the field not existing yet.
        || (
        isMember(groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberAvailability'])
        && (
          !('memberAvailability' in resource.data)
          ? request.resource.data.memberAvailability.keys().hasOnly([myEmail()])
          : request.resource.data.memberAvailability
              .diff(resource.data.memberAvailability)
              .affectedKeys().hasOnly([myEmail()])
        )
      );

      allow delete: if isSchoolAdmin()
        || (signedIn() && resource.data.createdBy == myEmail());

      // ------------------------------------------------------- messages
      match /messages/{messageId} {
        allow read: if isMember(groupId) || isSchoolAdmin();
        allow create: if isMember(groupId)
          && (request.resource.data.senderEmail == myEmail()
              || request.resource.data.senderEmail == 'jarvis@assistant.ai')
          && (
            (request.resource.data.type == 'event'
              && hasGroupPermission(groupId, 'manage_events'))
            || (request.resource.data.type == 'announcement'
              && hasGroupPermission(groupId, 'post_announcements'))
            // Honour the group's whoCanPost setting for regular messages.
            || (request.resource.data.type != 'event'
              && request.resource.data.type != 'announcement'
              && (groupData(groupId).whoCanPost != 'admins'
                  || hasGroupPermission(groupId, 'send_messages')))
          );

        // Any member may react and vote in polls, so those two fields are
        // writable by members — but nothing else about a message is, which
        // keeps someone from editing another person's text after the fact.
        allow update: if hasGroupPermission(groupId, 'manage_messages')
          || isSchoolAdmin() || (
          isMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reactions', 'poll'])
        );

        allow delete: if hasGroupPermission(groupId, 'manage_messages')
          || isSchoolAdmin();
      }

      // --------------------------------------------------------- events
      match /events/{eventId} {
        allow read: if isMember(groupId) || isSchoolAdmin();
        allow create, delete:
          if hasGroupPermission(groupId, 'manage_events') || isSchoolAdmin();
        allow update: if hasGroupPermission(groupId, 'manage_events')
          || (hasGroupPermission(groupId, 'manage_check_ins')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'checkInEnabled', 'checkInOpensAt', 'checkInClosesAt'
                 ]))
          || isSchoolAdmin();

        // ----------------------------------------------------- checkIns
        // The security-critical part. A check-in may only be written by an
        // admin of this group, for a member of this group, while check-in
        // is open, and never twice for the same person.
        match /checkIns/{memberUid} {
          function eventData() {
            return get(/databases/$(database)/documents/groups/$(groupId)/events/$(eventId)).data;
          }

          function checkInOpen() {
            let e = eventData();
            return e.checkInEnabled == true
              && (!('checkInOpensAt' in e) || request.time >= e.checkInOpensAt)
              // 15 minute grace period after close, matching the original
              // Cloud Function behaviour.
              && (!('checkInClosesAt' in e)
                  || request.time <= e.checkInClosesAt + duration.value(15, 'm'));
          }

          // Members can see who is present; the roster is not a secret.
          allow read: if isMember(groupId) || isSchoolAdmin();

          allow create: if hasGroupPermission(groupId, 'manage_check_ins')
            && checkInOpen()
            // The person being checked in must belong to this club.
            && request.resource.data.email in groupData(groupId).members
            // The document id must be the uid recorded inside it, which is
            // what makes a second scan a no-op rather than a duplicate row.
            && request.resource.data.uid == memberUid
            // Stamp integrity: the client cannot backdate a check-in or
            // attribute the scan to another officer.
            && request.resource.data.checkedInAt == request.time
            && request.resource.data.checkedInBy == myEmail()
            && request.resource.data.method in ['qr', 'manual'];

          // Attendance is append-only. Corrections are a delete by an admin,
          // which leaves no way to silently rewrite a record.
          allow update: if false;
          allow delete: if hasGroupPermission(groupId, 'manage_check_ins')
            || isSchoolAdmin();
        }
      }

      // ------------------------------------------------------- club days
      // A club day is one dated sign-in session, its id being the date
      // (2026-10-13), which is what makes "open today" idempotent.
      match /clubDays/{dateKey} {
        // Members can see their club's attendance; school admins see any.
        allow read: if isMember(groupId) || isSchoolAdmin();
        // Only roles with manage_check_ins start, reopen or close a day.
        allow create, update: if hasGroupPermission(groupId, 'manage_check_ins')
          || isSchoolAdmin();
        allow delete: if isSchoolAdmin();

        match /checkIns/{memberUid} {
          function dayIsOpen() {
            return get(/databases/$(database)/documents/groups/$(groupId)/clubDays/$(dateKey))
                     .data.isOpen == true;
          }

          allow read: if isMember(groupId) || isSchoolAdmin();

          // The security-critical rule: a member cannot sign themselves in.
          // Only a club admin may write a row, only while the day is open,
          // only for someone who belongs to the club, and only with a
          // server timestamp and their own name as the scanner.
          allow create: if hasGroupPermission(groupId, 'manage_check_ins')
            && dayIsOpen()
            && request.resource.data.email in groupData(groupId).members
            && request.resource.data.uid == memberUid
            && request.resource.data.checkedInAt == request.time
            && request.resource.data.checkedInBy == myEmail()
            && request.resource.data.method in ['qr', 'manual'];

          // Attendance is append-only. A correction is a delete by an
          // admin, so a record can never be quietly rewritten.
          allow update: if false;
          allow delete: if hasGroupPermission(groupId, 'manage_check_ins')
            || isSchoolAdmin();
        }
      }
    }

    // --------------------------------------------------------- friendships
    // One document per pair, id = both emails sorted and joined by '|'.
    // That shape is what lets these rules be short: there is no way to hold
    // two competing requests, and "who may accept" is a field comparison.
    match /friendships/{pairKey} {
      // resource is null for a document that does not exist; without that
      // guard, checking "is there already a request?" is itself denied.
      allow read: if signedIn()
        && (resource == null || myEmail() in resource.data.users);

      // You may only create a request you are part of, only as the sender,
      // and only in the pending state.
      allow create: if signedIn()
        && myEmail() in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.requestedBy == myEmail()
        && request.resource.data.status == 'pending';

      // Only the recipient answers, and only the answer may change. The
      // sender cannot accept on the other person's behalf.
      allow update: if signedIn()
        && myEmail() in resource.data.users
        && resource.data.requestedBy != myEmail()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'respondedAt']);

      // Either side can walk away: cancelling a request you sent and
      // unfriending are the same act.
      allow delete: if signedIn() && myEmail() in resource.data.users;
    }

    // ------------------------------------------------------ direct messages
    match /directMessages/{threadId} {
      function participants() {
        return resource.data.participants;
      }

      allow read: if signedIn()
        && (resource == null || myEmail() in participants());
      allow create: if signedIn()
        && myEmail() in request.resource.data.participants;
      allow update: if signedIn() && myEmail() in participants();
      allow delete: if false;

      match /messages/{messageId} {
        function threadParticipants() {
          return get(/databases/$(database)/documents/directMessages/$(threadId))
                   .data.participants;
        }

        allow read: if signedIn() && myEmail() in threadParticipants();
        // As in a group room, an @jarvis reply is written by the asking
        // participant's client on the bot's behalf.
        allow create: if signedIn()
          && myEmail() in threadParticipants()
          && (request.resource.data.senderEmail == myEmail()
              || request.resource.data.senderEmail == 'jarvis@assistant.ai');
        // Reactions are the only edit a participant may make; the message
        // text itself stays immutable.
        allow update: if signedIn()
          && myEmail() in threadParticipants()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reactions']);
        allow delete: if false;
      }
    }
  }
}
